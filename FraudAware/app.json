{
  "expo": {
    "name": "CareerNet",
    "slug": "FraudAware",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/Group1.png",
      "resizeMode": "contain",
      "backgroundColor": "#060C36"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Allow CareerNet to record voice messages in InChat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060C36"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CareerNet to access your photos to upload chat screenshots."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow CareerNet to record voice messages in InChat."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#202871",
          "defaultChannel": "chat-messages"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060C36",
          "image": "./assets/icons/Group1.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bff30255-7423-4cfa-bc8b-3378977ad146"
      }
    },
    "owner": "kajanthan"
  }
}
