PORT=5004
USER_MANAGEMENT_BASE_URL=http://127.0.0.1:5005
JOB_MANAGEMENT_BASE_URL=http://127.0.0.1:5001

NYLAS_CLIENT_ID=
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
# Must match a callback URI registered in Nylas AND used by the dashboard after OAuth.
# For local dashboard callback pages, configure Nylas to redirect to the dashboard URL,
# then the dashboard page forwards code/state to this service with the user Bearer token.
# Default fallback redirect. Also allowlist both portal callbacks in the Nylas app:
#   http://localhost:3000/recruiter/email/callback
#   http://localhost:3000/company/email/callback
NYLAS_REDIRECT_URI=http://localhost:3000/recruiter/email/callback
NYLAS_STATE_SECRET=change-me
JWT_SECRET=greatStack

