PORT=5003
MONGO_URI=mongodb://127.0.0.1:27017/fraudaware-chat
# Must match user-management JWT_SECRET
JWT_SECRET=greatStack
# Used to validate applications before creating a conversation
JOB_MANAGEMENT_BASE_URL=http://127.0.0.1:5001
USER_MANAGEMENT_BASE_URL=http://127.0.0.1:5000
# FastAPI scam-detection service (POST /classify)
# Must match services/scam-detection on port 8000 (app.main:app). Do not run another
# uvicorn on 127.0.0.1:8000 — Windows will route localhost traffic to the wrong process.
SCAM_DETECTION_BASE_URL=http://127.0.0.1:8000
# Optional — publish chat.message.created for Notifications tab
RABBITMQ_URL=amqp://fraudaware:fraudaware@127.0.0.1:5672
# Shared with job-management for interview reminder InChat posts
INTERNAL_SERVICE_KEY=fraudaware-internal-dev
# Required for chat image uploads
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
