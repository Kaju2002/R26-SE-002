# Copy to .env and fill in. Never commit .env.

# Existing FraudAware services (local defaults shown)
SCAM_DETECTION_URL=http://127.0.0.1:8000
EMPLOYER_VERIFICATION_URL=http://127.0.0.1:8001
FAKE_JOB_DETECTION_URL=http://127.0.0.1:8003

# LLM: gemini | none (guided mode only)
LLM_PROVIDER=gemini
# Key from Google AI Studio
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new API keys
GEMINI_MODEL=gemini-3.8-flash
# Seconds to wait for one Gemini reply before guided mode answers instead
LLM_TIMEOUT_SECONDS=20

# Comma-separated browser origins allowed by CORS. Leave empty for mobile-only use.
CORS_ORIGINS=
# Seconds to wait for each service in /health
HEALTH_TIMEOUT_SECONDS=3
# Seconds to wait for each check (job post images and company checks are slow)
JOB_POST_TIMEOUT_SECONDS=90
EMPLOYER_CHECK_TIMEOUT_SECONDS=90
RECRUITER_CHECK_TIMEOUT_SECONDS=60

# Must match user-management JWT_SECRET. Used by scripts/try_checks.py to create a test login token.
JWT_SECRET=
