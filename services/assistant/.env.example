# Copy to .env and fill in. Never commit .env.

# Existing FraudAware services (local defaults shown)
SCAM_DETECTION_URL=http://127.0.0.1:8000
EMPLOYER_VERIFICATION_URL=http://127.0.0.1:8001
FAKE_JOB_DETECTION_URL=http://127.0.0.1:8003

# LLM: gemini | none (guided mode only)
LLM_PROVIDER=gemini
# Key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed by CORS. Leave empty for mobile-only use.
CORS_ORIGINS=
# Seconds to wait for each service in /health
HEALTH_TIMEOUT_SECONDS=3
