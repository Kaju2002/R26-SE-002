PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/fraudaware-jobs
JWT_SECRET=greatStack
# Optional RabbitMQ for application/interview events
RABBITMQ_URL=amqp://fraudaware:fraudaware@127.0.0.1:5672
EMAIL_MANAGEMENT_BASE_URL=http://127.0.0.1:5004
CHAT_MANAGEMENT_BASE_URL=http://127.0.0.1:5003
# Must match chat-management INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=fraudaware-internal-dev
# Interview reminders (P3)
INTERVIEW_REMINDER_ENABLED=true
INTERVIEW_REMINDER_POLL_MS=60000
# true = T-5m / T-2m windows for local testing (turn off in production)
INTERVIEW_REMINDER_TEST_MODE=false
