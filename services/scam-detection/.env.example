PORT=8000
MONGO_URI=
MODEL_PATH=
PHASE1_PATH=
TACTIC_THRESHOLD=
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Must match user-management JWT_SECRET (app users send their login token)
JWT_SECRET=
# Must match chat-management INTERNAL_SERVICE_KEY (recruiter message checks)
INTERNAL_SERVICE_KEY=
# Comma-separated browser origins allowed by CORS. Leave empty for mobile-only use.
CORS_ORIGINS=
# Text/image/OCR analyses allowed per logged-in user per minute
SCAM_RATE_LIMIT_PER_MINUTE=20
